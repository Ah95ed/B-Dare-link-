{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter Default (Production)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "API_BASE_URL=https://wonder-link-backend.amhmeed31.workers.dev"
            ]
        },
        {
            "name": "Flutter Local (Android Emulator)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "API_BASE_URL=http://10.0.2.2:8787"
            ]
        },
        {
            "name": "Flutter Local (iOS/Web/Desktop)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define",
                "API_BASE_URL=http://127.0.0.1:8787"
            ]
        },
        {
            "name": "Launch Edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}